# =============================================================================
# ResumeMatch AI — Frontend Environment Configuration (Vercel / Production)
# =============================================================================

# Render Backend URL
# Set this in your Vercel Project Settings -> Environment Variables.
# Examples:
#   VITE_API_URL=https://resumematch-backend.onrender.com
#   VITE_API_URL=https://resumematch-backend.onrender.com/api
#
# Note: For local development with 'npm run dev', you can leave this blank,
# and the Vite dev server will automatically proxy requests to http://127.0.0.1:4000/api.
VITE_API_URL=https://your-backend-service.onrender.com

