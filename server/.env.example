# =============================================================================
# ResumeMatch AI — Backend Environment Configuration (Render / Production)
# =============================================================================

# Server Port & Binding (Render assigns PORT automatically)
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# -----------------------------------------------------------------------------
# CORS & Allowed Frontend Origins
# -----------------------------------------------------------------------------
# Set FRONTEND_URL to your exact Vercel deployment URL (without trailing slash)
# Example: https://resumematch-ai.vercel.app
FRONTEND_URL=https://your-frontend-app.vercel.app

# Optional: Comma-separated list of additional allowed origins
# (Localhost ports like 5173, 5174, 5175 are automatically allowed for dev)
ALLOWED_ORIGINS=https://your-frontend-app.vercel.app

# Optional: Set to 'true' to allow dynamic Vercel preview branch deployments (*.vercel.app)
ALLOW_VERCEL_PREVIEWS=true

# -----------------------------------------------------------------------------
# Database Configuration (MongoDB Atlas)
# -----------------------------------------------------------------------------
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/resumematch?retryWrites=true&w=majority
# If omitted or unavailable, the backend automatically falls back to in-memory storage.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/resumematch?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# AI Provider Configuration (Groq, OpenAI, or OpenRouter)
# -----------------------------------------------------------------------------
# API key for the AI inference provider
AI_API_KEY=your_ai_api_key_here

# Base URL for the OpenAI-compatible API endpoint
# For Groq: https://api.groq.com/openai/v1
# For OpenAI: https://api.openai.com/v1
# For OpenRouter: https://openrouter.ai/api/v1
AI_BASE_URL=https://api.groq.com/openai/v1

# Target Model Identifier
# For Groq: openai/gpt-oss-120b or llama-3.3-70b-versatile
# For OpenAI: gpt-4o-mini
AI_MODEL=openai/gpt-oss-120b

# AI Timeout in milliseconds (default: 45000 = 45s)
AI_TIMEOUT_MS=45000

# -----------------------------------------------------------------------------
# Upload Constraints
# -----------------------------------------------------------------------------
# Maximum resume file upload size in Megabytes (default: 8)
MAX_UPLOAD_MB=8
